OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DATABASE_URL=
# Local: vercel link && vercel env pull .env.local (refresh expired tokens).
# Vercel deployments authenticate Sandbox automatically via OIDC.
VERCEL_OIDC_TOKEN=
# Optional dedicated signing secret; falls back to OPENAI_API_KEY.
TOOL_PROPOSAL_SECRET=
